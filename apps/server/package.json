{
  "name": "@daily-log/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "start:voice": "node dist/voice/main.js",
    "dev:voice": "tsx src/voice/main.ts",
    "dev:auth-demo": "tsx src/auth/demo.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "budget:carryover": "tsx src/budget/carryover-cli.ts",
    "budget:status": "tsx src/budget/status-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json && node ../../scripts/copy-migrations.mjs"
  },
  "dependencies": {
    "fastify": "^5.0.0",
    "pg": "^8.0.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.0.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.0.0",
    "vitest": "4.1.11"
  }
}
