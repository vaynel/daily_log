# 복사: cp .env.example .env  (.env는 커밋 금지). 값은 예시이며 실제 비밀값을 넣지 말 것.
# 필수 (누락 시 서버/작업자가 누락 항목을 표시하고 종료)
DATABASE_URL=postgres://daily_log:change-me@localhost:5432/daily_log_dev
FILE_STORAGE_DIR=./data/files
SESSION_SECRET=replace-with-random-32+chars-for-local-dev-only
# 선택
PORT=3000
HOST=127.0.0.1
REDIS_URL=
WORKER_POLL_INTERVAL_MS=2000
# 음성 대화 시험 도구(TASK-73, 선택): 키 값 자체가 아니라 0600 파일 경로를 지정한다.
# DAILY_LOG_OPENAI_KEY_FILE=
# DAILY_LOG_GEMINI_KEY_FILE=
# DAILY_LOG_SIWC_DIR=
# DAILY_LOG_VOICE_PRO_MODEL=
# DAILY_LOG_VOICE_PRO_SUPPORT_VERIFIED=false
# DAILY_LOG_VOICE_SESSION_DIR=
# DAILY_LOG_VOICE_BUDGET_KRW=1000
# DAILY_LOG_VOICE_PORT=3100
# 월 예산 원장(TASK-13): 음성 서버는 DATABASE_URL 이 필수. 단가·환율/세금 여유는 JSON 으로 갱신한다(docs/budget/task-13.md).
# DAILY_LOG_VOICE_PRICING_JSON={"usdKrw":1500,"fxMargin":0.05,"taxRate":0.1}
# DAILY_LOG_VOICE_LIVE_PRICING_JSON={"usdKrw":1500,"fxMargin":0.05,"taxRate":0.1}
