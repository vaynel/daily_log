{
  "name": "daily-log",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": { "node": ">=22" },
  "workspaces": ["apps/server", "apps/web"],
  "scripts": {
    "dev:server": "npm run dev -w apps/server",
    "dev:worker": "npm run dev:worker -w apps/server",
    "dev:web": "npm run dev -w apps/web",
    "db:migrate": "npm run db:migrate -w apps/server",
    "db:seed": "npm run db:seed -w apps/server",
    "lint": "eslint .",
    "typecheck": "npm run typecheck -ws",
    "test": "npm run test -ws --if-present && npm run test:siwc",
    "test:siwc": "node --test scripts/siwc/*.test.mjs scripts/voice-measure.test.mjs",
    "siwc": "node scripts/siwc-cli.mjs",
    "build": "npm run build -ws",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:spike && npm run test:records-crash && npm run test:queue-restart && npm run test:notify-e2e",
    "test:spike": "node --test scripts/pro-spike.test.mjs",
    "test:records-crash": "node scripts/records-crash-e2e.mjs",
    "test:queue-restart": "node scripts/queue-restart-e2e.mjs",
    "test:notify-e2e": "node scripts/notify-e2e.mjs",
    "test:calendar-e2e": "node scripts/calendar-e2e.mjs",
    "test:voice-e2e": "node scripts/voice-e2e.mjs",
    "test:voice-live-e2e": "node scripts/voice-live-e2e.mjs",
    "test:paging-e2e": "node scripts/paging-e2e.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
