# PM 설치용 예시. 실제 값을 넣은 파일은 /etc/daily-log/push-test.env (0600, root 소유)로만 두고 커밋하지 않는다.
# 비밀값(VAPID 개인키, 접근 토큰)은 환경변수가 아니라 아래 파일 경로로만 지정한다.
DATABASE_URL=postgres://daily_log:change-me@127.0.0.1:5432/daily_log
FILE_STORAGE_DIR=/var/lib/daily-log/files
SESSION_SECRET=replace-with-random-32+chars
HOST=127.0.0.1
PORT=3000
PUSH_ENABLED=1
PUSH_VAPID_PUBLIC_KEY=<secrets/vapid-public.key 의 내용>
PUSH_VAPID_PRIVATE_KEY_FILE=/etc/daily-log/secrets/vapid-private.key
PUSH_VAPID_SUBJECT=mailto:pm@example.invalid
PUSH_ACCESS_TOKEN_FILE=/etc/daily-log/secrets/access-token
PUSH_STATE_FILE=/var/lib/daily-log/push-state.json
PUSH_STATIC_DIR=/opt/daily-log/apps/web/dist
# TLS 프록시(Caddy 등) 뒤에서 HOST를 loopback이 아닌 주소로 바꿀 때만:
# PUSH_ALLOW_NON_LOOPBACK=1
